{
  "name": "pi-graph-settings",
  "version": "0.1.0",
  "private": true,
  "description": "M17 host-independent settings protocol, discovery and transaction coordination.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.upstream",
  "engines": { "node": ">=22.19.0" },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/public/v1/index.ts",
    "./v1/*": "./src/public/v1/*.ts",
    "./registry": "./src/registry.ts",
    "./coordinator": "./src/coordinator.ts"
  },
  "files": ["src/**/*.ts", "LICENSE.upstream", "PROVENANCE.json"],
  "scripts": {
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
