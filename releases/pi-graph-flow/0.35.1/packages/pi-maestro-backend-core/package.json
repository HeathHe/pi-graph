{
  "name": "pi-maestro-backend-core",
  "version": "0.1.5",
  "description": "Versioned teammate execution-backend contracts shared by Pi Maestro plugins.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/bundle-settings-core.mjs",
    "postpack": "node ../../scripts/bundle-settings-core.mjs --clean"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/public/v1/index.ts",
    "./v1/spec": "./src/public/v1/spec.ts",
    "./v1/backend": "./src/public/v1/backend.ts",
    "./v1/registry": "./src/public/v1/registry.ts",
    "./v1/ssh": "./src/public/v1/ssh.ts"
  },
  "files": [
    "src/**/*.ts"
  ],
  "keywords": [
    "pi",
    "maestro",
    "teammate",
    "backend"
  ],
  "license": "ISC",
  "dependencies": {
    "pi-maestro-fabric-core": "0.1.0",
    "pi-graph-provider-backend": "0.1.0"
  },
  "bundledDependencies": [
    "pi-graph-provider-backend",
    "pi-maestro-fabric-core"
  ]
}
