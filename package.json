{
  "name": "pi-graph",
  "version": "0.2.3",
  "description": "Durable DAG execution with owned Pi SDK child agents",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "src/v3/",
    "agents/",
    "templates/",
    "README.md",
    "src/runtime/",
    "docs/owned-model-settings.md",
    "docs/session-continuation.md",
    "examples/",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run-isolated.ts suite",
    "pack:check": "npm pack --dry-run",
    "release:dry-run": "npm publish --dry-run --ignore-scripts --registry=https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-graph.ts",
      "./extensions/pi-graph-guard.ts"
    ]
  },
  "dependencies": {
    "jiti": "2.7.0",
    "yaml": "2.8.2"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^24.0.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.0"
  },
  "pi-graph": {
    "agents": [
      "./agents"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeathHe/pi-graph.git"
  },
  "homepage": "https://github.com/HeathHe/pi-graph#readme",
  "bugs": {
    "url": "https://github.com/HeathHe/pi-graph/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agents",
    "dag",
    "multi-agent",
    "workflow"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
