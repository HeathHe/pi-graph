{
  "name": "pi-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Durable DAG execution for Pi subagents",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "scripts/",
    "src/",
    "tests/assert-isolated-temp.ts",
    "tests/long-task-soak.ts",
    "tests/run-isolated.ts",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run-isolated.ts suite",
    "test:soak": "node --experimental-strip-types tests/run-isolated.ts soak",
    "test:latest-integration": "node --experimental-strip-types tests/pi-subagents-latest-integration.ts",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-graph.ts",
      "./extensions/pi-graph-guard.ts"
    ]
  },
  "dependencies": {
    "jiti": "2.7.0"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0",
    "pi-subagents": ">=0.40.0",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@types/node": "^24.0.0",
    "pi-subagents": "0.49.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.0"
  }
}
