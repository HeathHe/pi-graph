{
  "version": 1,
  "models": {
    "graph-example/local": {
      "provider": "graph-example",
      "id": "local",
      "name": "Example model: replace endpoint and model ID",
      "api": "openai-completions",
      "baseUrl": "https://api.example.invalid/v1",
      "input": ["text"],
      "contextWindow": 128000,
      "maxTokens": 8192,
      "reasoning": false,
      "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
      "auth": {"type": "env", "variable": "GRAPH_EXAMPLE_API_KEY"}
    }
  },
  "profiles": {
    "example-plan": {
      "model": "graph-example/local",
      "fallbackModels": [],
      "thinking": "off"
    }
  },
  "roles": {
    "custom-worker": {"profile": "example-plan"}
  }
}
